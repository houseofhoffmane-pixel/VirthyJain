{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "comment": "Production build compiles src/ only -> dist/server.js. seed/ and tests/ run via tsx/vitest (dev), so they are intentionally excluded from tsc.",
  "include": ["src/**/*"]
}
