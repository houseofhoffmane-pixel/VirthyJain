# ---------------------------------------------------------------------------
# Virthy Jain booking backend — environment
# Copy to `.env` and fill in. NEVER commit the real .env.
# Data residency: this app and its database MUST be hosted in the EU (health data).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
# Public origin of the front end, used in email links and CORS.
PUBLIC_BASE_URL=https://virthyjain.ie

# --- Database (host in the EU, e.g. eu-west-1 / Frankfurt) -------------------
DATABASE_URL=postgres://virthy:virthy@localhost:5432/virthy
# Set to "require" in production so TLS to Postgres is enforced.
DATABASE_SSL=disable

# --- Field encryption for health data (notes) -------------------------------
# 32-byte key, base64. Generate: `openssl rand -base64 32`
# Rotating: put the newest key first; older keys stay for decryption only.
DATA_ENCRYPTION_KEYS=CHANGE_ME_base64_32_bytes

# --- Signing secret for single-purpose patient tokens (cancel/reschedule) ----
# Generate: `openssl rand -base64 48`
TOKEN_SIGNING_SECRET=CHANGE_ME_long_random_secret

# --- Admin session cookie signing -------------------------------------------
SESSION_SECRET=CHANGE_ME_another_long_random_secret

# --- Admin login (single practitioner) --------------------------------------
ADMIN_EMAIL=virthy@virthyjain.ie
# bcrypt hash. Generate with: `npm run -s hash -- "your password"` (see README)
ADMIN_PASSWORD_HASH=CHANGE_ME_bcrypt_hash

# --- Transactional email (real domain, NOT the public Gmail) ----------------
# Use an EU email provider / SMTP relay.
SMTP_HOST=smtp.eu.mailprovider.com
SMTP_PORT=587
SMTP_USER=postmaster@virthyjain.ie
SMTP_PASS=CHANGE_ME
MAIL_FROM="Virthy Jain Physiotherapy <bookings@virthyjain.ie>"
# Where patient requests are delivered for Virthy to action.
PRACTITIONER_NOTIFY_EMAIL=virthy@virthyjain.ie
# If true, emails are written to ./outbox instead of sent (dev/test).
MAIL_DRY_RUN=true

# --- Retention (health data) -------------------------------------------------
# Records are hard-deletable per patient on request; and auto-purged after this.
RETENTION_MONTHS=84
