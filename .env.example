# Copy to .env for local dev. On Hostinger, set these as Environment Variables.

# --- Hostinger MySQL (Databases → your database) ---------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=your_database_name

# --- Admin panel login (/admin) --------------------------------------------
ADMIN_USER=virthy
ADMIN_PASSWORD=choose-a-password

# --- Links / CORS ----------------------------------------------------------
# Your Hostinger app URL (used in the cancel/manage links sent to patients).
PUBLIC_URL=https://aqua-trout-775752.hostingersite.com
# Where the public form is served (GitHub Pages). Leave as * if unsure.
CORS_ORIGIN=*

# --- Email (OPTIONAL — leave blank and the app still works) ----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Virthy Jain Physiotherapy <bookings@yourdomain.com>
PRACTITIONER_EMAIL=you@yourdomain.com
