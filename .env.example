# Copy to .env for local dev. On Hostinger, set these as Environment Variables.
# There is NO database. Bookings are emailed to you.

# Your public site URL (optional, used in copy).
PUBLIC_URL=https://green-anteater-179977.hostingersite.com
CORS_ORIGIN=*

# --- Where booking requests are sent ---------------------------------------
# The address YOU want to receive booking requests at (e.g. your Gmail).
PRACTITIONER_EMAIL=your@email.com

# --- How email is sent -----------------------------------------------------
# Option A (recommended): SMTP from a Hostinger email account or Gmail.
#   Hostinger email: hPanel -> Emails -> create an account, then use its SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Virthy Jain Physiotherapy <bookings@yourdomain.com>
# Option B: leave SMTP_HOST blank and the app tries the server's local mailer.
