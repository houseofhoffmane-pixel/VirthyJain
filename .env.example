# Copy to .env for local dev. On Hostinger, set these as Environment Variables.
# There is NO database — bookings are stored in a JSON file and emailed to you.

# --- REQUIRED: your public site URL ----------------------------------------
# The Accept / Reject buttons in your email link back to this URL, so it MUST
# be set to your live site address (no trailing slash).
PUBLIC_URL=https://green-anteater-179977.hostingersite.com
CORS_ORIGIN=*

# --- REQUIRED: where booking requests are sent -----------------------------
PRACTITIONER_EMAIL=virtee9808@gmail.com

# --- Email sending (Gmail example) -----------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=virtee9808@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
MAIL_FROM=Virthy Jain Physiotherapy <virtee9808@gmail.com>

# --- REQUIRED for accounts: session signing secret -------------------------
# Signs the login cookie. Use a long random string. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# --- Optional --------------------------------------------------------------
# View all requests at /bookings?key=THIS_VALUE
ADMIN_PASSWORD=
# Where the JSON files are stored. Default to your home directory (survives
# redeploys). Only set these if data resets after a redeploy.
DATA_FILE=
USERS_FILE=
